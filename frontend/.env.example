# Copy to .env.local (git-ignored) and adjust.
# Where the dev/preview server proxies /api (and /__backend/health). Default: http://localhost:8000
ACCORD_API_TARGET=http://localhost:8000
# Route prefix of the backend API. api-spec v0.1 backends (current backend branch) use /api; the older DealBattle v2 server used /api/v1.
VITE_API_PREFIX=/api
# Optional: call the backend directly instead of through the proxy (backend must allow this origin via CORS).
# VITE_API_BASE_URL=https://example.trycloudflare.com
